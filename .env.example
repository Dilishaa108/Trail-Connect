# PostgreSQL connection string
# For local development, use a local Postgres URL.
# For production (Vercel), use a managed service such as:
#   - Neon:      https://neon.tech
#   - Supabase:  https://supabase.com
#   - Railway:   https://railway.app
# Use Neon's *pooled* connection string on Vercel (host ends with -pooler).
# Append ?sslmode=require if Neon does not include it.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Frontend build settings (set automatically by Vercel via vercel.json)
BASE_PATH=/
PORT=3000
