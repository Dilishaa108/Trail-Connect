{
  "version": 2,
  "installCommand": "pnpm install --config.minimumReleaseAge=0",
  "buildCommand": "pnpm run typecheck:libs && pnpm --dir artifacts/api-server run build && pnpm --dir artifacts/trail-connect run build",
  "outputDirectory": "artifacts/trail-connect/dist/public",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
